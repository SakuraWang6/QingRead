# Repository-root context, deny by default. Only public build inputs below are
# sent to Docker; personal configuration, backups and signing material stay out.
**
!LICENSE
!App/
!App/Resources/
!App/Resources/AppInfo.json
!App/Resources/ProjectLicense.txt
!App/Resources/ThirdPartyNotices.txt
!Config/
!Config/App.xcconfig
!scripts/
!scripts/generate-release-manifest.py
!web/
!web/Dockerfile
!web/package.json
!web/package-lock.json
!web/LICENSE
!web/index.html
!web/tsconfig.json
!web/vite.config.ts
!web/capacitor.config.ts
!web/public/
!web/public/**
!web/src/
!web/src/**
!web/server/
!web/server/**

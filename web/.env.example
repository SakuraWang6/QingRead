# Copy to .env on the server; generate your own secret. Never commit .env.
# Example generation: openssl rand -hex 32
QINGREAD_ACCESS_TOKEN=
# Explicit opt-in for a shared service without an access code.
# Leaving a token configured still requires that token even when this is true.
QINGREAD_PUBLIC_ACCESS=false

# Exact HTTPS origin(s), comma-separated. Replace this example with your domain.
# The existing service already accepts Capacitor https://localhost and
# capacitor://localhost. Do not use * or paths such as /api here.
QINGREAD_ALLOWED_ORIGINS=https://read.example.com

# Bind only 127.0.0.1 on the server. Change this if another app uses port 8787.
QINGREAD_PORT=8787

# Bound concurrent upstream connections for small servers (1..8, default 4).
QINGREAD_UPSTREAM_CONCURRENCY=4

# Dedicated QingRead host only. On a shared host, merge explicit routes instead
# of replacing its root/catch-all. See shared-host/README.md.
{
    log default {
        format filter {
            wrap json
            fields {
                request>headers>X-Qingread-Token delete
                request>headers>Authorization delete
            }
        }
    }
    auto_https disable_redirects
    default_sni {$QINGREAD_PUBLIC_HOST}
    servers {
        protocols h1 h2
    }
}

https://{$QINGREAD_PUBLIC_HOST} {
    tls {
        issuer acme https://acme-v02.api.letsencrypt.org/directory {
            profile shortlived
            disable_http_challenge
        }
    }

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        -Server
    }
    handle /downloads/QingRead-Android-*.apk {
        root * /downloads
        uri strip_prefix /downloads
        header Content-Disposition "attachment"
        file_server
    }
    handle {
        reverse_proxy qingread:8787 {
            flush_interval -1
        }
    }
}

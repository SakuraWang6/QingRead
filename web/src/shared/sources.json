  {
    "id": "biquge-tw",
    "name": "笔趣阁 · biquge.tw",
    "summary": "独立站内搜索，支持繁简书名。目录与内容质量取决于该网站。",
    "homeURL": "https://www.biquge.tw/",
    "kind": "html",
    "html": {
      "searchURL": "/search/?searchkey={query}",
      "resultSelector": ".result-card",
      "titleSelector": "a.book-title",
      "linkSelector": "a.book-title",
      "authorSelector": ".author",
      "summarySelector": ".book-intro",
      "coverSelector": ".book-cover img",
      "catalogLinkSelector": "a.chapterlist",
      "chapterSelector": ".booklist > ul > li > a",
      "contentSelector": "#chaptercontent",
      "encoding": "utf8",
      "removeSelectors": []
    }
  },
  {
    "id": "piaotia",
    "name": "飘天文学",
    "summary": "GBK 站内搜索。精确命中与多结果搜索都使用网站给出的完整目录链接。",
    "homeURL": "https://www.piaotia.com/",
    "kind": "html",
    "html": {
      "searchURL": "/modules/article/search.php?searchkey={query}",
      "resultSelector": "#centerm #content:has(h1), table.grid tr:has(td.odd:first-child > a[href*='/bookinfo/'])",
      "titleSelector": "h1, td.odd:first-child a",
      "linkSelector": "a[title^='点击阅读'], td.even a[href*='/html/']",
      "authorSelector": "td.odd:nth-child(3)",
      "coverSelector": "img[src*='/files/article/image/']",
      "chapterSelector": ".centent li a",
      "contentSelector": "body",
      "encoding": "gbk",
      "removeSelectors": [
        "body > :not(br)"
      ]
    }
  },
